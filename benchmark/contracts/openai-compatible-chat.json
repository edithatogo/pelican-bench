{
  "contract_id": "contract:openai-compatible-chat-v1",
  "schema_version": "1.0.0",
  "provider": "openai-compatible-chat-completions",
  "consumer": "pelicanbench",
  "description": "Request and response surfaces consumed by the OpenAI-compatible generation adapter.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["model", "messages", "temperature", "max_tokens", "seed", "stream"],
    "properties": {
      "model": {"type": "string", "minLength": 1},
      "messages": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["role", "content"],
          "properties": {
            "role": {"enum": ["system", "user", "assistant"]},
            "content": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "temperature": {"type": "number", "minimum": 0},
      "max_tokens": {"type": "integer", "minimum": 1},
      "seed": {"type": "integer", "minimum": 0},
      "stream": {"type": "boolean"}
    },
    "additionalProperties": true
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["choices"],
    "properties": {
      "choices": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["message"],
          "properties": {
            "message": {
              "type": "object",
              "required": ["content"],
              "properties": {
                "content": {
                  "oneOf": [
                    {"type": "string"},
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["text"],
                        "properties": {"text": {"type": "string"}},
                        "additionalProperties": true
                      }
                    }
                  ]
                }
              },
              "additionalProperties": true
            },
            "finish_reason": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "usage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {"type": "integer", "minimum": 0},
          "completion_tokens": {"type": "integer", "minimum": 0},
          "total_tokens": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  },
  "required_consumer_assertions": [
    "At least one user message contains the exact benchmark prompt.",
    "The response contains one complete SVG document before semantic scoring.",
    "Credentials and raw authorization headers are never persisted in trial metadata."
  ]
}
