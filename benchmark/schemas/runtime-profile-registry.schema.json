{
  "$defs": {
    "RuntimePromptProfile": {
      "additionalProperties": false,
      "properties": {
        "assistant_prefill": {
          "default": "",
          "title": "Assistant Prefill",
          "type": "string"
        },
        "endpoint_kind": {
          "enum": [
            "openai-compatible",
            "command",
            "directory",
            "fixture"
          ],
          "title": "Endpoint Kind",
          "type": "string"
        },
        "first_user_prefix": {
          "default": "",
          "title": "First User Prefix",
          "type": "string"
        },
        "max_tokens": {
          "default": 12000,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "model_ids": {
          "items": {
            "type": "string"
          },
          "title": "Model Ids",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "experimental",
          "enum": [
            "active",
            "experimental",
            "blocked",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        },
        "system_prompt": {
          "default": "Return one complete, self-contained SVG document and no explanatory prose. Do not embed raster images, scripts, external resources, or hidden text.",
          "title": "System Prompt",
          "type": "string"
        },
        "temperature": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "profile_id",
        "model_ids",
        "endpoint_kind",
        "source"
      ],
      "title": "RuntimePromptProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy",
      "type": "object"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/RuntimePromptProfile"
      },
      "title": "Profiles",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "policy",
    "profiles"
  ],
  "title": "RuntimeProfileRegistry",
  "type": "object"
}
